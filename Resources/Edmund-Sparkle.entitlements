<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements for the shipping (GitHub + Sparkle) build. The ad-hoc dev
         variant of build-app.sh signs without any entitlements so the
         ReproScript CGEvent driver keeps working. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- NSDocument open/save panels; also the folder grant panel (FolderAccess). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Security-scoped bookmarks for document folders (sibling images, wiki
         links) survive relaunch only with app-scope bookmarks. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.print</key>
    <true/>
    <!-- The usual document folders, so most notes need no folder grant.
         GitHub build only: App Review scrutinizes temporary exceptions
         (the MAS file carries just the Apple-blessed Downloads one). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Documents/</string>
        <string>/Desktop/</string>
        <string>/Downloads/</string>
    </array>
    <!-- Sparkle feed/downloads, the RaTeX payload download, remote images. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Sparkle 2's sandbox XPC services (installer launcher + status). The
         names derive from the Info.plist bundle id, not the signing id. -->
    <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
    <array>
        <string>com.i7t5.edmund-spks</string>
        <string>com.i7t5.edmund-spki</string>
    </array>
</dict>
</plist>
