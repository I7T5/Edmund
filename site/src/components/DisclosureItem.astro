---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<!-- The markup Read mode renders for a collapsed `> [!faq]-` callout
     (HTMLRenderer), styled by read.css; the icon is LucideIcons' circle-question-mark. -->
<details class="callout callout-faq callout-collapsible">
  <summary class="callout-title">
    <span class="callout-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
    </span>
    <span class="callout-title-text">{question}</span>
  </summary>
  <div class="callout-body">
    <slot />
  </div>
</details>
