---
import BaseLayout from "../layouts/BaseLayout.astro";
import SideSection from "../components/SideSection.astro";
import DisclosureItem from "../components/DisclosureItem.astro";
import ExpandableScreenshot from "../components/ExpandableScreenshot.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FeaturesCardGrid from "../components/FeaturesCardGrid.astro";


const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const screenshots = [
  {
    src: `${base}assets/v0.1.0_basic.png`,
    alt: "Edmund editing a Markdown document with inline preview",
  },
  {
    src: `${base}assets/v0.1.0_gfm-syntax.png`,
    alt: "Edmund rendering GitHub Flavored Markdown syntax",
  },
  {
    src: `${base}assets/v0.1.0_more-syntax.png`,
    alt: "Edmund showing additional Markdown syntax support",
  },
  {
    src: `${base}assets/v0.1.0_read-mode.png`,
    alt: "Edmund in read mode with the document content aligned beside the editor",
  },
];

const videoId = "hero-video";
---

<BaseLayout
  pageTitle="Edmund"
  description="Edmund is a minimal native Markdown editor for macOS with inline live preview."
>
  <section id="demo" class="flex min-h-[100svh] items-center px-0 py-8 sm:px-2 lg:px-4">
    <div class="mx-auto flex w-full flex-col">
      <figure class="m-3 mb-8 overflow-hidden rounded-[8px] shadow-[0_10px_30px_rgba(0,0,0,0.08)] sm:rounded-[12px] sm:m-4 sm:mb-10 lg:m-6 lg:mb-10">
        <video
          id={videoId}
          class="h-auto w-full"
          autoplay
          loop
          playsinline
          preload="auto"
          tabindex="0"
        >
          <source src={`${base}assets/v0.1.0_video.mp4`} type="video/mp4" />
        </video>
      </figure>

      <div class="pb-3 sm:pb-4 lg:pb-6">
        <h1 class="font-serif text-2xl font-semibold leading-tight sm:text-4xl">Edmund</h1>
        <p class="mt-5 text-xl leading-8 text-secondary">
          A minimal, file-based, native macOS Markdown editor with inline live preview. 
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex items-center gap-2 rounded-[8px] bg-primary px-4 py-2 text-sm font-sans font-semibold text-white transition transition-duration-300 hover:text-white hover:bg-primary-strong"
            href="https://github.com/I7T5/Edmund/releases/latest"
          >
            Download (beta)
            <span class="i-lucide-download h-4 w-4" aria-hidden="true"></span>
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-[8px] bg-tertiary px-4 py-2 text-sm font-sans font-semibold text-text transition transition-duration-300 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black"
            href="https://github.com/I7T5/Edmund"
          >
            Repository
            <span class="i-lucide-github h-4 w-4" aria-hidden="true"></span>
          </a>
        </div>
        <p class="mt-3 text-sm leading-6 text-secondary font-sans">
          Requires macOS 14 Sonoma or later. (<a href="https://github.com/I7T5/Edmund#installation">Damaged?</a>)
        </p>

        <!-- Animation to scroll here -->
      </div>
    </div>
  </section>

  <SideSection id="overview" title="Yet another Markdown editor?">
    <div class="space-y-5 text-lg leading-8">
      <p>
        As of July 2026, I have not found a Markdown editor that is 
        <i>native to macOS</i>, <b>file-based</b>, and has <i><b>inline WYSIWYG live preview</b></i>
        all at the same time. Which is why I made Edmund.
      </p>
      <p>
        Edmund aims to just blend in with macOS and your workflow, 
        whether as a complement to your Markdown knowledge base, or as a standalone editor, or both.
      </p>
      <p>
        We hope that Edmund feels so natural that you forget how often you use it every day, 
        but also beautiful enough that, every once in a while, you pause and appreciate the font antialiasing / color palette / smooth rendering.
      </p>
    </div>
  </SideSection>

  <section id="features" class="my-4">
    <h2 class="text-2xl font-semibold mb-2">Features</h2>
    <p class="text-secondary mb-4">There's more on the <a href="https://trello.com/b/vw2TveNI">Roadmap</a>.</p>
    <FeaturesCardGrid />
  </section>

  <!-- Later: Change to scroll view -->
  <section id="screenshots" class="grid gap-8 py-10">
    <h2 class="text-2xl font-semibold">Screenshots</h2>
    <!-- <p class="text-secondary">Scroll to see more :)</p> -->
    <div class="grid gap-4 sm:grid-cols-2">
      {screenshots.map((shot, index) => (
        <ExpandableScreenshot src={shot.src} alt={shot.alt} loading={index === 0 ? "eager" : "lazy"} />
      ))}
    </div>
  </section>

  <section class="mt-4 mb-12">
    <h2 class="text-2xl font-semibold mb-1">Comparisons</h2>
    <p class="text-secondary mb-4">And <a href="https://github.com/mundimark/awesome-markdown-editors">alternatives</a>, if Edmund's not for you. Scroll for more :D</p>
    <ComparisonTable />
  </section>

  <section id="acknowledgements" class="my-2">
    <h2 class="text-2xl font-semibold">Acknowledgements</h2>
    <ul class="my-4 pl-4 text-secondary">
      <li>
        <a href="https://coteditor.com">CotEditor</a> for the philosophy</li>
      <li>
        <a href="https://typora.io">Typora</a> and{' '}
        <a href="https://obsidian.md">Obsidian</a> for the much of the vision</li>
      <li>
        <a href="https://github.com/nodes-app/swift-markdown-engine">Swift Markdown Engine</a> for the architecture reference</li>
      <li>
        <a href="https://github.com/swiftlang/swift-markdown">swift-markdown</a>,{' '}
        <a href="https://github.com/mgriebling/SwiftMath">SwiftMath</a>,{' '}
        <a href="https://github.com/sparkle-project/Sparkle">Sparkle</a>,{' '}
        <a href="https://ratex.lites.dev">RaTeX</a> and
        <a href="https://shiki.style">Shiki</a> for core and extension functionalities</li>
      <li>Apple and creators of{' '}
        <a href="https://en.wikipedia.org/wiki/Iowan_Old_Style">Iowan Old Style,</a>{' '}
        <a href="https://github.com/chriskempson/tomorrow-theme">Tomorrow Light</a>, and{' '}
        <a href="https://github.com/Binaryify/OneDark-Pro">One Dark Pro</a> for the aesthetics</li>
      <li>
        <a href="https://github.com/sindresorhus/create-dmg">create-dmg</a> and{' '}
        <a href="https://screenshot-studio.com">screenshot-studio</a> for the utilities</li>
      <li>Claude,{' '}
        <a href="https://github.com/JuliusBrussee/caveman">caveman</a>, and{' '}
        <a href="https://github.com/DietrichGebert/ponytail">ponytail</a> for the engineering</li>
    </ul>
  </section>

  <SideSection id="faqs" title="FAQs">
    <div class="px-5">
      <DisclosureItem question="How much does Edmund cost?">
        Edmund is and will always be free, at least as long as I (I7T5) am in charge. 
      </DisclosureItem>
      <DisclosureItem question="Is Edmund just another Electron/WebKit wrapper?">
        No. Edmund uses AppKit and TextKit 2 for editing and WebKit for reading only.
      </DisclosureItem>
      <DisclosureItem question="What's your wallpaper?">
        It's a photo by Gleb Kosenko on <a href="https://unsplash.com/photos/aerial-photography-of-ocean-waves-1v-snxcyHHk">Unsplash</a>.
        I founded it through <a href="https://leonspok.com">Irvue</a>.
      </DisclosureItem>
      <DisclosureItem question="Where did Edmund get its name?">
        <p class="mb-2">
          Edmund is techincally an expansion of "edmd", 
          short for "<b>ED</b>itor for <b>M</b>ark<b>D</b>own."
        </p>
        <p>
          It may also be thought of as an subtle yet wholehearted tribute to{' '}
          <a class="text-link" href="https://narnia.fandom.com/wiki/Edmund_Pevensie_(Walden)">Narnia</a>{' '} 
          and its author C.S. Lewis.
        </p>
      </DisclosureItem>
    </div>
  </SideSection>
</BaseLayout>

<script>
  const video = document.getElementById("hero-video");

  if (video instanceof HTMLVideoElement) {
    const setControls = (enabled: boolean) => {
      video.controls = enabled;
    };

    setControls(false);

    video.addEventListener("pointerenter", () => setControls(true));
    video.addEventListener("pointerleave", () => setControls(false));
    video.addEventListener("focus", () => setControls(true));
    video.addEventListener("blur", () => setControls(false));
  }
</script>
