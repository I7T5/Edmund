---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
// Read mode's own stylesheet, so the site reads like a document open in Edmund.
import '../styles/read.css';

interface Props {
  pageTitle?: string;
  description?: string;
}

const {
  pageTitle = "Edmund",
  description = "A native Markdown editor for macOS with inline live preview.",
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        /* Neutrals and links defer to read.css so the page takes Read mode's palette. */
        --color-background: var(--bg);
        --color-surface: var(--bg);
        --color-tertiary: #f2f2f7;
        --color-border: var(--rule);
        --color-text: var(--fg);
        --color-secondary: var(--faint);
        --color-primary: #ff6916;
        --color-primary-strong: #ee5605;
        --color-link: var(--accent);
        --color-link-strong: #0051d5;
        --color-link-soft: #dbe9ff;
        --page-max-width: 680px;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* UnoCSS's reset strips list markers; read.css restores only ul's. */
      ol { list-style-type: decimal; }
      a { transition: color 0.3s ease; }
      a:hover { color: var(--color-link-strong); }
      #acknowledgements a, #acknowledgements a:hover { color: inherit; text-decoration: none; }
      #acknowledgements a:hover { font-weight: bold; }
      
      /* Dark mode variant after I record a dark mode version of the video */
      /* @media (prefers-color-scheme: dark) {
        :root {
          --color-background: #2d2f30;
          --color-surface: #353739;
          --color-tertiary: #404244;
          --color-border: #4f5153;
          --color-text: #f5f5f7;
          --color-secondary: #a1a1aa;
          --color-primary: #0a84ff;
          --color-primary-strong: #409cff;
          --color-primary-soft: #1e2a3d;
        }
      } */
    </style>
  </head>
  <body>
    <div class="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
