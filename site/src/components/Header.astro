---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: base, label: "Edmund", current: path === base.replace(/\/$/, "") },
  { href: `${base}icons/`, label: "App icons", current: path.endsWith("/icons") },
];
---

<header class="mb-12">
  <nav class="flex gap-5 font-sans text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.current ? "page" : undefined}
        class:list={[
          "no-underline hover:text-text",
          link.current ? "text-text" : "text-secondary",
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>
