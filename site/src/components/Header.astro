---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: base, label: "Edmund", icon: "i-lucide-file-text", current: path === base.replace(/\/$/, "") },
  { href: `${base}icons/`, label: "App icons", icon: "i-lucide-layout-grid", current: path.endsWith("/icons") },
];
---

<header class="site-nav mb-12">
  <button class="nav-toggle" type="button" aria-controls="site-nav-links" aria-expanded="true" aria-label="Hide sidebar">
    <span class="i-lucide-panel-left h-4 w-4" aria-hidden="true"></span>
  </button>
  <nav id="site-nav-links" class="flex gap-5 font-sans text-sm">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.current ? "page" : undefined}
        class:list={[
          "no-underline hover:text-text",
          link.current ? "text-text" : "text-secondary",
        ]}
      >
        <span class:list={["nav-icon h-4 w-4", link.icon]} aria-hidden="true"></span>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .nav-icon, .nav-toggle { display: none; }

  /* Wide windows: a floating sidebar in the left gutter, inset from the
     window edges like a macOS Tahoe sidebar. 1100px leaves the 680px column
     a 20px clearance from the panel. Narrower windows keep the top row. */
  @media (min-width: 1100px) {
    .site-nav {
      position: fixed;
      top: 10px;
      left: 10px;
      z-index: 30;
      width: 176px;
      margin: 0;
      padding: 10px 8px;
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 18px;
      background: rgba(246, 246, 248, 0.72);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .site-nav nav { flex-direction: column; gap: 2px; }

    .site-nav a,
    .site-nav a:hover {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 8px;
      color: var(--fg);
    }

    .site-nav a[aria-current="page"] { background: rgba(0, 0, 0, 0.06); }

    /* Sidebar symbols take the accent tint, as in Finder: Edmund's orange. */
    .nav-icon { display: inline-block; color: var(--color-primary); }

    .nav-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      margin: 0 0 4px 4px;
      border-radius: 8px;
      color: var(--faint);
      cursor: pointer;
    }
    .nav-toggle:hover { background: rgba(0, 0, 0, 0.06); color: var(--fg); }

    /* Collapsed (BaseLayout restores the choice before first paint): only the
       toggle remains, as a small floating button. */
    :global(html[data-sidebar="collapsed"]) .site-nav { width: auto; padding: 4px; }
    :global(html[data-sidebar="collapsed"]) .site-nav nav { display: none; }
    :global(html[data-sidebar="collapsed"]) .nav-toggle { margin: 0; }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector(".nav-toggle");

  const sync = () => {
    const collapsed = root.dataset.sidebar === "collapsed";
    toggle?.setAttribute("aria-expanded", String(!collapsed));
    toggle?.setAttribute("aria-label", collapsed ? "Show sidebar" : "Hide sidebar");
  };

  sync();
  toggle?.addEventListener("click", () => {
    const collapsed = root.dataset.sidebar !== "collapsed";
    root.dataset.sidebar = collapsed ? "collapsed" : "open";
    try {
      localStorage.setItem("sidebar", root.dataset.sidebar);
    } catch {}
    sync();
  });
</script>
